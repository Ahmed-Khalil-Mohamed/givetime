{
  "name": "givetime",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Volunteer shift planning with capacity limits, attendance and verified hours. A bilingual calendar for community coordinators.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx server/main.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "start": "node dist-server/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/noto-sans-arabic": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "express": "^5.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "esbuild": "latest",
    "prettier": "3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ahmed-Khalil-Mohamed/givetime.git"
  },
  "bugs": {
    "url": "https://github.com/Ahmed-Khalil-Mohamed/givetime/issues"
  },
  "homepage": "https://github.com/Ahmed-Khalil-Mohamed/givetime#readme",
  "license": "MIT"
}
